generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  PROVIDER
  ADMIN
  SUPER_ADMIN
  MODERATOR
  FINANCE
}
enum ListingStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  SUSPENDED
  REJECTED
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}
enum PaymentProvider {
  MPESA_STK
  MANUAL
  MOCK
}
enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}
enum LeadType {
  VIEW
  PHONE_REVEAL
  WHATSAPP_CLICK
  INQUIRY
}
enum ModerationStatus {
  PENDING
  APPROVED
  HIDDEN
}
enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}
enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  PHONE_VERIFY
}
enum DiscountType {
  PERCENT
  FIXED
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String @unique
  passwordHash String
  role Role @default(PROVIDER)
  emailVerified DateTime?
  phoneVerified DateTime?
  suspendedAt DateTime?
  sessionVersion Int @default(0)
  totpSecretEncrypted String?
  totpEnabled Boolean @default(false)
  profile ProviderProfile?
  listings Listing[]
  payments Payment[]
  reviews Review[]
  inquiries Inquiry[]
  notifications Notification[]
  reports Report[]
  auditLogs AuditLog[]
  otpCodes OtpCode[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([role, suspendedAt])
  @@index([createdAt])
}
model ProviderProfile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio String?
  businessName String?
  verificationDocumentKey String?
  consentAt DateTime
  consentVersion String @default("2025-01")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  icon String?
  position Int @default(0)
  active Boolean @default(true)
  subcategories Subcategory[]
  listings Listing[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Subcategory {
  id String @id @default(cuid())
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name String
  slug String
  listings Listing[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([categoryId, slug])
}
model County {
  id String @id @default(cuid())
  code Int @unique
  name String
  slug String @unique
  towns Town[]
  listings Listing[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Town {
  id String @id @default(cuid())
  countyId String
  county County @relation(fields: [countyId], references: [id], onDelete: Restrict)
  name String
  slug String
  areas Area[]
  listings Listing[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([countyId, slug])
}
model Area {
  id String @id @default(cuid())
  townId String
  town Town @relation(fields: [townId], references: [id], onDelete: Restrict)
  name String
  slug String
  listings Listing[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([townId, slug])
}
model Listing {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name String
  slug String @unique
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId String?
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  countyId String
  county County @relation(fields: [countyId], references: [id], onDelete: Restrict)
  townId String?
  town Town? @relation(fields: [townId], references: [id], onDelete: SetNull)
  areaId String?
  area Area? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  description String @db.Text
  services String[]
  address String?
  latitude Float?
  longitude Float?
  phone String
  whatsapp String?
  email String?
  website String?
  socialLinks Json?
  workingHours Json?
  minPrice Decimal? @db.Decimal(12, 2)
  maxPrice Decimal? @db.Decimal(12, 2)
  yearsExperience Int?
  logoKey String?
  verificationDocumentKey String?
  status ListingStatus @default(DRAFT)
  rejectionReason String?
  verified Boolean @default(false)
  featuredUntil DateTime?
  expiresAt DateTime?
  planId String?
  plan Plan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  images ListingImage[]
  subscriptions Subscription[]
  addonPurchases AddonPurchase[]
  payments Payment[]
  reviews Review[]
  inquiries Inquiry[]
  leadEvents LeadEvent[]
  reports Report[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, categoryId, countyId])
  @@index([townId, areaId])
  @@index([ownerId, status])
  @@index([status, featuredUntil, createdAt])
  @@index([expiresAt, status])
}
model ListingImage {
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  storageKey String
  url String
  alt String
  width Int
  height Int
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([listingId, position])
}
model Plan {
  id String @id @default(cuid())
  name String
  slug String @unique
  price Decimal @db.Decimal(12, 2)
  durationDays Int
  maxPhotos Int
  maxServices Int
  featuredIncluded Boolean @default(false)
  priorityWeight Int @default(0)
  badge String?
  active Boolean @default(true)
  listings Listing[]
  subscriptions Subscription[]
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Addon {
  id String @id @default(cuid())
  name String
  slug String @unique
  price Decimal @db.Decimal(12, 2)
  durationDays Int
  placement String
  active Boolean @default(true)
  payments Payment[]
  purchases AddonPurchase[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AddonPurchase {
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  addonId String
  addon Addon @relation(fields: [addonId], references: [id], onDelete: Restrict)
  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  startsAt DateTime
  endsAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([endsAt])
}
model Subscription {
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  planId String
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentId String? @unique
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  startsAt DateTime
  endsAt DateTime
  status SubscriptionStatus @default(PENDING)
  reminders ReminderDelivery[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([listingId, status])
  @@index([status, endsAt])
}
model ReminderDelivery {
  id String @id @default(cuid())
  subscriptionId String
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  daysBefore Int
  sentAt DateTime @default(now())
  @@unique([subscriptionId, daysBefore])
}
model Payment {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  planId String?
  plan Plan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  addonId String?
  addon Addon? @relation(fields: [addonId], references: [id], onDelete: Restrict)
  couponId String?
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: Restrict)
  amount Decimal @db.Decimal(12, 2)
  currency String @default("KES")
  phone String
  status PaymentStatus @default(PENDING)
  provider PaymentProvider
  merchantRequestId String?
  checkoutRequestId String? @unique
  mpesaReceiptNumber String? @unique
  resultCode Int?
  resultDesc String?
  rawCallback Json?
  idempotencyKey String @unique
  manualNote String?
  subscription Subscription?
  addonPurchase AddonPurchase?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paidAt DateTime?
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([listingId])
}
model Coupon {
  id String @id @default(cuid())
  code String @unique
  type DiscountType
  value Decimal @db.Decimal(12, 2)
  expiresAt DateTime?
  usageLimit Int?
  usageCount Int @default(0)
  active Boolean @default(true)
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Review {
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating Int
  comment String @db.Text
  status ModerationStatus @default(PENDING)
  providerReply String?
  repliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([listingId, userId])
  @@index([listingId, status])
}
model Inquiry {
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  name String
  email String
  phone String?
  message String @db.Text
  consentAt DateTime
  readAt DateTime?
  spam Boolean @default(false)
  repliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([listingId, createdAt])
}
model LeadEvent {
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type LeadType
  visitorHash String?
  createdAt DateTime @default(now())
  @@index([listingId, type, createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  message String
  link String?
  readAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, readAt, createdAt])
}
model Report {
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason String
  detail String?
  status ReportStatus @default(OPEN)
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String
  targetType String
  targetId String?
  metadata Json?
  ipHash String?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
model Setting {
  key String @id
  value Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model EmailTemplate {
  id String @id @default(cuid())
  key String @unique
  subject String
  body String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model SmsTemplate {
  id String @id @default(cuid())
  key String @unique
  body String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model OtpCode {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose TokenPurpose
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose, expiresAt])
}
model RateLimit {
  key String @id
  count Int @default(1)
  resetAt DateTime
  updatedAt DateTime @updatedAt
  @@index([resetAt])
}
model Delivery {
  id String @id @default(cuid())
  channel String
  recipient String
  subject String?
  body String @db.Text
  attempts Int @default(0)
  sentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sentAt, createdAt])
}
