# PostgreSQL: use a pooled URL for runtime and a direct URL for migrations.
DATABASE_URL=postgresql://fundifind:development-only@localhost:5432/fundifind
DIRECT_URL=postgresql://fundifind:development-only@localhost:5432/fundifind
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Generate with: openssl rand -base64 32. Never expose as NEXT_PUBLIC_*.
SEED_ADMIN_NAME=FundiFind Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=0712345678
SEED_ADMIN_PASSWORD=
# At least 12 characters. Seed does not overwrite an existing admin.
# console delivery is only allowed outside production; local development only.
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=FundiFind <hello@example.com>
SMS_PROVIDER=stub
# Future Africa's Talking adapter (Stage 6)
AT_USERNAME=
AT_API_KEY=
# Only set true behind an edge that overwrites X-Forwarded-For.
TRUST_PROXY=false
PAYMENT_PROVIDER=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox
# Cloudinary image uploads (required for provider listing photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Future reminders (Stage 6)
CRON_SECRET=
